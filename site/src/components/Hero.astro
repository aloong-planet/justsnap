---
// The hero (landing-page::REQ-007, US-001/AC-01): the title, one paragraph, the download button with the platform
// line, and a screenshot. It fills the first screen (REQ-003/AC-03). The button is rendered in the list state, which
// is what the page offers until something tells it more (REQ-001/AC-04).
import { view } from '../download'
import { ui, type Locale } from '../i18n/ui'
import { SHOT_SIZE, shotSrc } from '../shots'
import Icon from './Icon.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = ui[locale]
const { hero } = view({ kind: 'list' }, locale)
---

<section class="hero" id="top">
  <div class="wrap">
    <div>
      <h1>{t.hero.title}</h1>
      <p class="lead">{t.hero.lead}</p>
      <div class="dl">
        <a class="btn primary" href={hero.href} target={hero.newTab ? '_blank' : undefined} rel={hero.newTab ? 'noopener' : undefined}>
          <Icon name="download" size={18} />{hero.label}
        </a>
        <div class="meta"><span>{t.platform}</span></div>
      </div>
    </div>
    <div class="shot">
      <img src={shotSrc('hero', locale)} width={SHOT_SIZE.width} height={SHOT_SIZE.height} alt={t.hero.shotAlt} />
    </div>
  </div>
</section>
