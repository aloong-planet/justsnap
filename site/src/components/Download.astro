---
// The download and install section (landing-page::REQ-002, US-004): the download area, rendered in the list state
// as served (REQ-001/AC-04), then the three install steps.
import { view } from '../download'
import { ui, type Locale } from '../i18n/ui'
import Icon from './Icon.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = ui[locale]
const { section } = view({ kind: 'list' }, locale)
---

<section class="section" id="download">
  <div class="wrap">
    <h2>{t.download.title}</h2>
    <div class="dlbox">
      <p class="ver">{section.line}</p>
      <div class="row">
        {
          section.buttons.map((b) => (
            <a class="btn primary" href={b.href} target={b.newTab ? '_blank' : undefined} rel={b.newTab ? 'noopener' : undefined}>
              <Icon name="download" size={18} />{b.label}
            </a>
          ))
        }
      </div>
    </div>
    <h3 class="sub">{t.install.title}</h3>
    <div class="cards">
      {
        t.install.steps.map((s, i) => (
          <div class="card">
            <div class="no">{i + 1}</div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
