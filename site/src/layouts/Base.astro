---
// The page's frame: the head, the sticky header (the breadcrumb back to the homepage that ends on the brand,
// navigation, language toggle) and the footer (landing-page::REQ-003, landing-page::REQ-009). Each language's page
// fills the main region with the same sections.
//
// The breadcrumb follows the WAI-ARIA Authoring Practices breadcrumb pattern: a labelled navigation landmark around
// an ordered list, with the link to this page marked as the current page. The separator is text hidden from assistive
// technology rather than generated content, which most browsers expose to it.
import '../styles/global.css'
import { REPOSITORY, RELEASE_LIST } from '../download'
import { HOMEPAGE, LANGUAGE_NAME, LOCALES, PAGE_PATH, ui, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = ui[locale]
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon.png" type="image/png" />
  </head>
  <body>
    <header class="hdr">
      <div class="wrap">
        <nav aria-label={t.breadcrumbLabel}>
          <ol class="crumbs">
            <li class="crumbs-up">
              <a class="crumbs-home" href={HOMEPAGE.url}>{HOMEPAGE.name}</a>
              <span class="crumbs-sep" aria-hidden="true">/</span>
            </li>
            <li>
              <a class="brand" href="#top" aria-current="page">
                <img class="brand-mark" src="/icon.svg" alt="" width="28" height="28" />{t.brand}
              </a>
            </li>
          </ol>
        </nav>
        <nav class="nav" aria-label={t.nav.label}>
          <a href="#features">{t.nav.features}</a>
          <a href="#download">{t.nav.download}</a>
          <a href={REPOSITORY} target="_blank" rel="noopener">{t.nav.github}</a>
        </nav>
        <span class="lang" role="group" aria-label={t.langLabel}>
          {
            LOCALES.map((l) =>
              l === locale ? (
                <span class="cur" aria-current="page" lang={ui[l].htmlLang}>
                  {LANGUAGE_NAME[l]}
                </span>
              ) : (
                <a href={PAGE_PATH[l]} hreflang={ui[l].htmlLang} lang={ui[l].htmlLang} data-switch-language>
                  {LANGUAGE_NAME[l]}
                </a>
              )
            )
          }
        </span>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap">
        <a href={REPOSITORY} target="_blank" rel="noopener">{t.footer.github}</a>
        <a href={RELEASE_LIST} target="_blank" rel="noopener">{t.footer.releases}</a>
        <span class="copy">{t.footer.copyright}</span>
      </div>
    </footer>
    <script>
      import { initDownload } from '../scripts/download'
      import { initFeatures } from '../scripts/features'
      import { initLanguageSwitch } from '../scripts/language-switch'
      // Initialize features before the language switch, which may restore the visitor's current step.
      initFeatures()
      initLanguageSwitch()
      // Should anything fail before a state is shown, the page stays in the list state it was served in, which is a
      // valid way to download
      initDownload(document, (url, init) => fetch(url, init)).catch(() => undefined)
    </script>
  </body>
</html>
